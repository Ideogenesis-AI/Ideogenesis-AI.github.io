---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

// Font imports — processed by Vite, self-hosted in the build output
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

const {
  title = 'Ideogenesis AI',
  description = 'Advancing AI technologies for physical research through innovative pattern recognition on quantum lattice model data.',
  ogImage = '/og-image.png',
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://Ideogenesis-AI.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const ogImageUrl = new URL(ogImage, siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b15" />

    <!-- Mark JS availability before first paint so reveal animations
         only hide content when the observer can reveal it again -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl.href} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageUrl.href} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"    content="Ideogenesis AI" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />

    <!-- Shared IntersectionObserver for scroll reveals -->
    <script is:inline>
      (function () {
        const observer = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );

        function observe() {
          document.querySelectorAll('.reveal, .reveal-stagger').forEach(function(el) {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observe);
        } else {
          observe();
        }
      })();
    </script>

    <!-- Shared PyPI version lookup for any [data-pypi="pkg"] element -->
    <script is:inline>
      (function () {
        var CACHE_TTL = 60 * 60 * 1000; // 1 hour

        function read(pkg) {
          try {
            var raw = localStorage.getItem('pypi_v_' + pkg);
            if (!raw) return null;
            var e = JSON.parse(raw);
            return Date.now() - e.ts > CACHE_TTL ? null : e.v;
          } catch (_) { return null; }
        }
        function write(pkg, v) {
          try { localStorage.setItem('pypi_v_' + pkg, JSON.stringify({ v: v, ts: Date.now() })); } catch (_) {}
        }

        var byPkg = {};
        document.querySelectorAll('[data-pypi]').forEach(function (el) {
          var pkg = el.getAttribute('data-pypi');
          if (!pkg) return;
          (byPkg[pkg] = byPkg[pkg] || []).push(el);
        });

        Object.keys(byPkg).forEach(function (pkg) {
          var apply = function (v) {
            byPkg[pkg].forEach(function (el) { el.textContent = 'PyPI · v' + v; });
          };
          var cached = read(pkg);
          if (cached) { apply(cached); return; }
          fetch('https://pypi.org/pypi/' + pkg + '/json')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
              var v = data && data.info && data.info.version;
              if (v) { write(pkg, v); apply(v); }
            })
            .catch(function () { /* keep placeholder */ });
        });
      })();
    </script>
  </body>
</html>
