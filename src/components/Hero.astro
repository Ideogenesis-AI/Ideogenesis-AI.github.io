---
---

<section class="hero" id="hero">
  <canvas class="hero__canvas" id="lattice-canvas" aria-hidden="true"></canvas>

  <div class="hero__content container">
    <div class="hero__badge reveal">
      <span class="badge__dot"></span>
      <span>Research · AI · Quantum Physics</span>
    </div>

    <h1 class="hero__title reveal">
      <span class="hero__title-word">Ideogenesis</span>
      <span class="hero__title-accent shimmer"> AI</span>
    </h1>

    <p class="hero__tagline reveal">
      Acquiring new physical insights via AI algorithms on ensembles<br class="hero__br" />
      of data from quantum lattice simulations
    </p>

    <div class="hero__ctas reveal">
      <a href="#projects" class="btn btn--primary">Explore Projects</a>
      <a
        href="https://github.com/Ideogenesis-AI"
        class="btn btn--secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        View on GitHub
      </a>
    </div>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="scroll-hint__line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-base);
    overflow: hidden;
  }

  /* Canvas fills the section */
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.42;
    pointer-events: none;
  }

  /* Soft mask: a gentle pool of background behind the text so copy stays
     legible, and a vignette toward the edges. No hard ring, so fronts
     travelling across the lattice read continuously. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 46% 40% at 50% 50%,
        rgba(7, 11, 21, 0.92) 0%,
        rgba(7, 11, 21, 0.70) 45%,
        rgba(7, 11, 21, 0.00) 100%
      ),
      radial-gradient(
        ellipse 100% 100% at 50% 50%,
        rgba(7, 11, 21, 0.00) 60%,
        rgba(7, 11, 21, 0.70) 100%
      ),
      linear-gradient(to bottom, rgba(7, 11, 21, 0) 80%, var(--bg-base) 100%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-top: calc(var(--nav-h) + var(--space-8));
    padding-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  /* Title */
  .hero__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .hero__title-accent {
    display: inline-block;
  }

  /* Shimmer gradient text */
  .shimmer {
    background: linear-gradient(
      90deg,
      var(--accent-cyan) 0%,
      var(--accent-blue) 35%,
      var(--text-primary) 50%,
      var(--accent-blue) 65%,
      var(--accent-cyan) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 4s linear infinite;
  }

  /* Tagline */
  .hero__tagline {
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.65;
    font-weight: 400;
  }

  .hero__br {
    display: none;
  }

  @media (min-width: 640px) {
    .hero__br {
      display: block;
    }
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition:
      background 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
    min-height: 44px;
  }

  .btn--primary {
    background: var(--accent-cyan);
    color: #060b15;
    border: 1px solid var(--accent-cyan);
  }

  .btn--secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
  }

  /* Buttons lift on hover; cards do not — keeps the motion language distinct */
  @media (hover: hover) {
    .btn--primary:hover {
      background: #1adbff;
      color: #060b15;
      transform: translateY(-2px);
    }
    .btn--secondary:hover {
      border-color: var(--accent-blue);
      color: var(--accent-blue);
      transform: translateY(-2px);
      background: rgba(61, 142, 248, 0.06);
    }
  }

  /* Scroll hint */
  .hero__scroll-hint {
    position: absolute;
    bottom: var(--space-7);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .scroll-hint__line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, var(--accent-cyan));
    animation: scroll-fade 2s ease-in-out infinite;
  }

  @keyframes scroll-fade {
    0%   { opacity: 0; transform: scaleY(0); transform-origin: top; }
    50%  { opacity: 1; transform: scaleY(1); transform-origin: top; }
    100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
  }

  /* Stagger the hero content reveals */
  .hero__content .reveal:nth-child(1) { animation-delay: 0.1s; }
  .hero__content .reveal:nth-child(2) { animation-delay: 0.2s; }
  .hero__content .reveal:nth-child(3) { animation-delay: 0.3s; }
  .hero__content .reveal:nth-child(4) { animation-delay: 0.4s; }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById('lattice-canvas');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    var dpr = window.devicePixelRatio || 1;
    var raf = null;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Lattice geometry ─────────────────────────────────────
    // Square lattice with a fixed spacing in CSS px. Column/row counts are
    // derived from the canvas size so cells stay square and identical at
    // every viewport; the grid is centred in the canvas.
    var SPACING = 72;
    var MIN_PAD = 24;
    var COLS = 0, ROWS = 0;

    // ── Correlation-front ("quench") dynamics ────────────────
    // The *_REF values are tuned for a 1440x900 canvas. Because the lattice
    // spacing is fixed, a larger window has more area; to keep the perceived
    // density of illumination the same, the quench rate and front count are
    // scaled with canvas area and the front reach with canvas diagonal.
    // The live values (without _REF) are derived in buildLattice().
    var REF_W = 1440, REF_H = 900;
    var FRONT_SPEED   = 0.13;   // px per ms
    var FRONT_WIDTH   = 56;     // gaussian sigma of the front, px
    var FRONT_R0_REF  = 300;    // amplitude falls off as 1 / (1 + r / R0)
    var FRONT_PEAK    = 0.6;    // excitation at the front's origin (0..1)
    var MAX_FRONTS_REF   = 2;
    var QUENCH_MIN_REF   = 3200; // ms between quenches (min)
    var QUENCH_RANGE_REF = 2600; // + random up to this
    var DECAY_TAU     = 1300;   // afterglow decay time constant, ms

    var FRONT_R0 = FRONT_R0_REF, MAX_FRONTS = MAX_FRONTS_REF;
    var QUENCH_MIN = QUENCH_MIN_REF, QUENCH_RANGE = QUENCH_RANGE_REF;

    // ── Phase layer ──────────────────────────────────────────
    var PHASE_FRACTION = 0.12;  // share of bonds carrying a rotating phase
    var PHASE_RATE     = 0.00040; // rad per ms

    // ── Pointer coupling ─────────────────────────────────────
    var POINTER_R_REF  = 160;   // influence radius, px (scaled with diagonal)
    var POINTER_R      = POINTER_R_REF;
    var POINTER_GAIN   = 0.45;  // peak excitation added under the pointer

    // ── Radial emphasis ──────────────────────────────────────
    // Far from the centre the lattice tends to look empty on wide screens.
    // Sites beyond an ABSOLUTE pixel distance from the centre get a gain on
    // excitation and baseline brightness, and quench origins are biased out
    // there. Because the ramp is in pixels, small windows (< ~1200px wide)
    // are essentially unaffected; at 1440×900 only the corners and the
    // outermost columns are touched; on large monitors the wide margins get
    // the full boost.
    var RADIAL_START_PX = 620;  // distance from centre where the ramp starts
    var RADIAL_FULL_PX  = 980;  // distance where it reaches OUTER_GAIN
    var OUTER_GAIN      = 2.4;  // excitation multiplier at full distance
    var OUTER_BASE      = 0.9;  // baseline alpha boost at full distance (+90%)

    // Colour endpoints (cyan → blue)
    var C0 = [0, 212, 255], C1 = [61, 142, 248];

    var nodes = [];        // { x, y, col, row, base, emph, t, gain }
    var exc   = [];        // per-site excitation, 0..1
    var bonds = [];        // { a, b, phase, rate, isPhase, base }
    var fronts = [];       // { x, y, r, amp }
    var lastT = 0;
    var nextQuench = 1200;
    var pointer = { x: -1e9, y: -1e9, active: false };

    // Colour lookup: 0 = cyan, 1 = blue, in 32 steps (avoids per-frame string work)
    var LUT_N = 32, LUT = [];
    for (var li = 0; li <= LUT_N; li++) {
      var lt = li / LUT_N;
      LUT.push(
        Math.round(C0[0] + (C1[0] - C0[0]) * lt) + ',' +
        Math.round(C0[1] + (C1[1] - C0[1]) * lt) + ',' +
        Math.round(C0[2] + (C1[2] - C0[2]) * lt)
      );
    }
    function lerpColor(t) {
      return LUT[Math.round((t < 0 ? 0 : t > 1 ? 1 : t) * LUT_N)];
    }
    // Excitation colour: the front itself is cyan, the cooling wake shifts
    // toward blue, so a passing front leaves a coloured trail
    function heat(e) { return lerpColor(1 - e * 1.6); }

    // Pre-rendered radial glow sprites (cyan and blue); drawn with drawImage
    // and globalAlpha instead of building a gradient per site per frame
    var GLOW_PX = 64;
    function makeGlow(rgb) {
      var c = document.createElement('canvas');
      c.width = c.height = GLOW_PX;
      var g = c.getContext('2d');
      var grd = g.createRadialGradient(GLOW_PX / 2, GLOW_PX / 2, 0, GLOW_PX / 2, GLOW_PX / 2, GLOW_PX / 2);
      grd.addColorStop(0, 'rgba(' + rgb + ',1)');
      grd.addColorStop(1, 'rgba(' + rgb + ',0)');
      g.fillStyle = grd;
      g.fillRect(0, 0, GLOW_PX, GLOW_PX);
      return c;
    }
    var glowCyan = makeGlow(C0.join(','));
    var glowBlue = makeGlow(C1.join(','));

    function buildLattice(w, h) {
      nodes = []; exc = []; bonds = []; fronts = [];

      // Scale dynamics to canvas size (see note above the constants)
      var areaScale = Math.min(3, Math.max(0.5, (w * h) / (REF_W * REF_H)));
      var diagScale = Math.sqrt(w * w + h * h) / Math.sqrt(REF_W * REF_W + REF_H * REF_H);
      QUENCH_MIN   = QUENCH_MIN_REF   / areaScale;
      QUENCH_RANGE = QUENCH_RANGE_REF / areaScale;
      MAX_FRONTS   = Math.max(2, Math.round(MAX_FRONTS_REF * areaScale));
      FRONT_R0     = FRONT_R0_REF  * diagScale;
      POINTER_R    = POINTER_R_REF * diagScale;

      COLS = Math.max(1, Math.floor((w - MIN_PAD * 2) / SPACING) + 1);
      ROWS = Math.max(1, Math.floor((h - MIN_PAD * 2) / SPACING) + 1);
      var offX = (w - (COLS - 1) * SPACING) / 2;
      var offY = (h - (ROWS - 1) * SPACING) / 2;
      var cx = w / 2, cy = h / 2;

      for (var r = 0; r < ROWS; r++) {
        for (var c = 0; c < COLS; c++) {
          var x = offX + c * SPACING, y = offY + r * SPACING;
          // Absolute pixel distance from the canvas centre
          var dxp = x - cx, dyp = y - cy;
          var dpx = Math.sqrt(dxp * dxp + dyp * dyp);
          var t = (dpx - RADIAL_START_PX) / (RADIAL_FULL_PX - RADIAL_START_PX);
          t = t < 0 ? 0 : t > 1 ? 1 : t;
          t = t * t * (3 - 2 * t); // smoothstep
          var base = 0.22 + Math.random() * 0.10;
          nodes.push({
            x: x, y: y, col: c, row: r,
            base: base * (1 + OUTER_BASE * t),        // brighter baseline outward
            emph: Math.random() < 0.08,               // a few emphasised sites
            t: t,
            gain: 1 + (OUTER_GAIN - 1) * t,           // excitation multiplier
          });
          exc.push(0);
        }
      }

      // Bonds: right and down from every site
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        if (n.col < COLS - 1) addBond(i, i + 1);
        if (n.row < ROWS - 1) addBond(i, i + COLS);
      }
    }

    function addBond(a, b) {
      var isPhase = Math.random() < PHASE_FRACTION;
      var t = (nodes[a].t + nodes[b].t) * 0.5;
      var base = isPhase ? 0.16 : 0.07 + Math.random() * 0.04;
      bonds.push({
        a: a, b: b,
        isPhase: isPhase,
        phase: Math.random() * Math.PI * 2,
        rate: PHASE_RATE * (0.6 + Math.random() * 0.8),
        base: base * (1 + OUTER_BASE * t),
        gain: 1 + (OUTER_GAIN - 1) * t,
      });
    }

    // Launch a correlation front from a random site, biased toward the
    // periphery (rejection sampling on the radial weight)
    function quench(t) {
      if (!nodes.length || fronts.length >= MAX_FRONTS) return;
      var idx = Math.floor(Math.random() * nodes.length);
      for (var tries = 0; tries < 6; tries++) {
        idx = Math.floor(Math.random() * nodes.length);
        if (Math.random() < 0.25 + 0.75 * nodes[idx].t) break;
      }
      var n = nodes[idx];
      fronts.push({ x: n.x, y: n.y, r: 0, amp: FRONT_PEAK });
      exc[idx] = FRONT_PEAK;
    }

    // ── Simulation step ──────────────────────────────────────
    function update(t, dt) {
      if (t >= nextQuench) {
        quench(t);
        nextQuench = t + QUENCH_MIN + Math.random() * QUENCH_RANGE;
      }

      var w = canvas.width / dpr, h = canvas.height / dpr;
      var maxR = Math.sqrt(w * w + h * h) + FRONT_WIDTH * 3;

      // Advance fronts
      for (var f = fronts.length - 1; f >= 0; f--) {
        var fr = fronts[f];
        fr.r += FRONT_SPEED * dt;
        fr.amp = FRONT_PEAK / (1 + fr.r / FRONT_R0);
        if (fr.r > maxR) fronts.splice(f, 1);
      }

      // Decay afterglow, then add pulses from any front passing a site
      var k = Math.exp(-dt / DECAY_TAU);
      var inv2s2 = 1 / (2 * FRONT_WIDTH * FRONT_WIDTH);
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var e = exc[i] * k;

        for (var g = 0; g < fronts.length; g++) {
          var q = fronts[g];
          var dx = n.x - q.x, dy = n.y - q.y;
          var d = Math.sqrt(dx * dx + dy * dy) - q.r;
          var pulse = q.amp * Math.exp(-d * d * inv2s2);
          if (pulse > e) e = pulse;           // front sets the level; decay carries it
        }

        // Pointer proximity adds a soft local excitation
        if (pointer.active) {
          var px = n.x - pointer.x, py = n.y - pointer.y;
          var pd2 = px * px + py * py;
          if (pd2 < POINTER_R * POINTER_R) {
            var fall = 1 - Math.sqrt(pd2) / POINTER_R;
            e = Math.max(e, POINTER_GAIN * fall * fall);
          }
        }

        exc[i] = e > 1 ? 1 : e;
      }

      // Rotate phases; the pointer speeds up nearby phase bonds
      for (var b = 0; b < bonds.length; b++) {
        var bd = bonds[b];
        if (!bd.isPhase) continue;
        var rate = bd.rate;
        if (pointer.active) {
          var na = nodes[bd.a], nb = nodes[bd.b];
          var mx = (na.x + nb.x) * 0.5 - pointer.x;
          var my = (na.y + nb.y) * 0.5 - pointer.y;
          var md2 = mx * mx + my * my;
          if (md2 < POINTER_R * POINTER_R) rate *= 1 + 5 * (1 - Math.sqrt(md2) / POINTER_R);
        }
        bd.phase += rate * dt;
      }
    }

    // ── Render ───────────────────────────────────────────────
    function render() {
      var w = canvas.width / dpr, h = canvas.height / dpr;
      ctx.clearRect(0, 0, w, h);

      // Bonds
      ctx.lineCap = 'round';
      for (var b = 0; b < bonds.length; b++) {
        var bd = bonds[b];
        var na = nodes[bd.a], nb = nodes[bd.b];
        var e = (exc[bd.a] + exc[bd.b]) * 0.5 * bd.gain;
        if (e > 1) e = 1;

        var col, alpha, width;
        if (bd.isPhase) {
          var tt = 0.5 + 0.5 * Math.sin(bd.phase);
          col = e > 0.25 ? heat(e) : lerpColor(tt);
          alpha = bd.base + e * 0.5;
          width = 0.8 + e * 1.0;
        } else {
          col = e > 0.05 ? heat(e) : '0,212,255';
          alpha = bd.base + e * 0.55;
          width = 0.6 + e * 1.1;
        }

        ctx.lineWidth = width;
        ctx.strokeStyle = 'rgba(' + col + ',' + alpha + ')';
        ctx.beginPath(); ctx.moveTo(na.x, na.y); ctx.lineTo(nb.x, nb.y); ctx.stroke();
      }

      // Front rings — one large, slow, readable motion per quench
      for (var f = 0; f < fronts.length; f++) {
        var fr = fronts[f];
        if (fr.r < 8) continue;
        ctx.lineWidth = 1;
        ctx.strokeStyle = 'rgba(0,212,255,' + (0.14 * fr.amp) + ')';
        ctx.beginPath(); ctx.arc(fr.x, fr.y, fr.r, 0, Math.PI * 2); ctx.stroke();
      }

      // Site glows (only where excited). Two sprites blended by heat: hot
      // sites draw mostly cyan, cooling sites mostly blue.
      for (var gi = 0; gi < nodes.length; gi++) {
        var nd = nodes[gi];
        var gv = exc[gi] * nd.gain;
        if (gv > 1) gv = 1;
        if (gv < 0.12) continue;
        var gr = 10 + gv * 14;
        var hot = gv * 1.6; if (hot > 1) hot = 1;
        var a = gv * 0.22;
        ctx.globalAlpha = a * hot;
        ctx.drawImage(glowCyan, nd.x - gr, nd.y - gr, gr * 2, gr * 2);
        ctx.globalAlpha = a * (1 - hot);
        ctx.drawImage(glowBlue, nd.x - gr, nd.y - gr, gr * 2, gr * 2);
      }
      ctx.globalAlpha = 1;

      // Sites
      for (var j = 0; j < nodes.length; j++) {
        var n2 = nodes[j];
        var ev = exc[j] * n2.gain;
        if (ev > 1) ev = 1;
        var radius = (n2.emph ? 2.0 : 1.5) + ev * 1.6;
        var alpha2 = Math.min(1, (n2.emph ? n2.base + 0.2 : n2.base) + ev * 0.6);
        ctx.beginPath(); ctx.arc(n2.x, n2.y, radius, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + (ev > 0.05 ? heat(ev) : '0,212,255') + ',' + alpha2 + ')'; ctx.fill();
      }
    }

    function frame(t) {
      var dt = lastT ? Math.min(t - lastT, 50) : 16;
      lastT = t;
      update(t, dt);
      render();
      raf = requestAnimationFrame(frame);
    }

    // ── Init ─────────────────────────────────────────────────
    function resize() {
      var w = canvas.offsetWidth, h = canvas.offsetHeight;
      canvas.width  = w * dpr; canvas.height = h * dpr;
      ctx.scale(dpr, dpr);
      buildLattice(w, h);
      if (reduced) render(); // static frame, no animation
    }

    resize();
    if (!reduced) raf = requestAnimationFrame(frame);

    var rTimer;
    window.addEventListener('resize', function () {
      clearTimeout(rTimer);
      rTimer = setTimeout(resize, 150);
    }, { passive: true });

    document.addEventListener('visibilitychange', function () {
      if (reduced) return;
      if (document.hidden) { cancelAnimationFrame(raf); raf = null; lastT = 0; }
      else if (!raf) { raf = requestAnimationFrame(frame); }
    });

    // Pointer coupling — the canvas has pointer-events: none, so listen on
    // the hero section and convert to canvas coordinates
    var hero = canvas.parentElement;
    if (hero && !reduced) {
      hero.addEventListener('pointermove', function (ev) {
        var rect = canvas.getBoundingClientRect();
        pointer.x = ev.clientX - rect.left;
        pointer.y = ev.clientY - rect.top;
        pointer.active = true;
      }, { passive: true });
      hero.addEventListener('pointerleave', function () {
        pointer.active = false;
      }, { passive: true });
    }
  })();
</script>

